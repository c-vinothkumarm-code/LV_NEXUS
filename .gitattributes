# Files executed or read on the Linux server must keep LF line endings, also when committed from Windows.
* text=auto
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.cnf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.pptx binary
