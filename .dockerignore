# Never send secrets, local environments or data into the image build context.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/secrets/
**/credentials*.json
**/*service-account*.json

# local tooling and caches
.git/
.github/
.vscode/
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.coverage
**/coverage.xml
**/htmlcov/
**/node_modules/
frontend/dist/
**/.scannerwork/

# runtime data and reports
logs/
**/*.log
**/*.db
**/*.sqlite*
**/validation-*.md
**/demo_check_report.md
docs/review/*.pptx
docs/screenshots/

# deployment material is not needed inside the application image
deploy/
infrastructure/
scripts/
