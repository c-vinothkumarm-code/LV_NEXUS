# LatentView CloudNexus configuration. Copy to .env (same folder as this file). Never commit .env.
# In production every secret comes from a secret store (Azure Key Vault / Google Secret Manager), not a file.

APP_ENV=local                       # local | production

# --- Database: MySQL now, Azure SQL later (see docs/deployment/azure-sql-migration.md) ---
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=mysql+pymysql://mcp:CHANGE_ME@127.0.0.1:3306/mcp?charset=utf8mb4
# Azure SQL later: mssql+pyodbc://USER:PASSWORD@SERVER.database.windows.net:1433/DB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes

FRONTEND_URL=http://localhost:5173  # unattended mode (API serves the dashboard): http://localhost:8000
CORS_ORIGINS=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
# FRONTEND_DIST=../frontend/dist     # set to serve the built dashboard from the API on port 8000

# --- Authentication ---
AUTH_MODE=dev                       # dev (local only) | entra (Microsoft Entra ID) | google
# Microsoft Entra ID sign-in (register a web app; redirect URI = FRONTEND_URL + /api/v1/auth/callback)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# A verified corporate sign-in grants nothing by itself: people must be in the access registry (Administration & Settings > Access
# registry), be in BOOTSTRAP_ADMIN_EMAILS, or be in a mapped Google group. Keep this false.
AUTH_AUTO_PROVISION=false
SESSION_SECRET=change-me-local-only # signs session cookies; production: >= 32 random characters (SECRET_KEY also accepted)
# --- Google Workspace sign-in (AUTH_MODE=google). See docs/google-workspace-sso.md ---
GOOGLE_CLIENT_ID=                   # OAuth 2.0 Web client ID (not secret)
GOOGLE_CLIENT_SECRET=               # from Secret Manager in production; never commit, never put in frontend code
GOOGLE_REDIRECT_URI=                # optional; default FRONTEND_URL + /api/v1/auth/callback; must match the OAuth client exactly
GOOGLE_ALLOWED_DOMAIN=latentview.com  # checked against the verified `hd` claim AND the e-mail domain
GOOGLE_WORKSPACE_ADMIN_GROUPS=      # optional, e.g. platform-admins@latentview.com (members = platform administrators)
GOOGLE_GROUP_ROLE_MAP=              # optional, e.g. cxo@latentview.com=executive,finops@latentview.com=finops_analyst
GOOGLE_GROUP_LOOKUP_ENABLED=false   # true = read group membership server-side (Cloud Identity API, Groups Reader role)
ALLOWED_EMAIL_DOMAINS=              # e.g. latentview.com (Entra ID; Google falls back to it when GOOGLE_ALLOWED_DOMAIN is empty)
BOOTSTRAP_ADMIN_EMAILS=             # first administrator(s) only
SESSION_TTL_MINUTES=480             # one session
SESSION_IDLE_MINUTES=60             # signed out after inactivity
SESSION_ABSOLUTE_MAX_MINUTES=720    # renewals never extend a sign-in beyond this
AUTH_THROTTLE_FAILURES=10           # denied sign-ins per IP in the window before throttling
AUTH_THROTTLE_WINDOW_MINUTES=15

# --- AWS (read-only; STS only; no access keys here, ever) ---
# Local: `aws sso login --profile <name>`. On-prem production: an IAM Roles Anywhere profile (certificate + credential_process).
AWS_ENABLED=false
AWS_PROFILE=                        # profile name in the AWS config of the account that runs CloudNexus
AWS_DEFAULT_REGION=us-east-1
AWS_MEMBER_ROLE_NAME=
AWS_EXTERNAL_ID=
AWS_REGIONS=                        # blank = every enabled region; or e.g. ap-south-1,us-east-1
AWS_MANAGEMENT_ROLE_ARN=            # production only (web identity federation)
AWS_WEB_IDENTITY_AUDIENCE=
# Optional: https URL of the S3 folder where your cloud team published deploy/aws/*.yaml; enables the one-click
# "quick create" link in Onboard a cloud > AWS. Leave empty to download the templates instead.
ONBOARDING_AWS_TEMPLATE_BASE_URL=

# --- GCP ---  Locally: `gcloud auth application-default login`
GCP_ENABLED=false
GCP_ORGANIZATION_ID=
GCP_CREDENTIALS_FILE=               # production: service-account key / federation config, e.g. C:\cloudnexus-secrets\gcp\cloudnexus-reader.json
GCP_BILLING_EXPORT_TABLE=           # project.dataset.gcp_billing_export_v1_XXXXXX
GCP_BILLING_QUERY_PROJECT=

# --- Azure ---  Service principal (recommended): set tenant, client ID and secret. Without them `az login` is used.
AZURE_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_PRINCIPAL_OBJECT_ID=          # Enterprise applications > the app > Object ID (NOT the app registration's object ID, NOT your user)

# --- SOC ---
SOC_TRUSTED_CIDRS=                  # office / VPN ranges, comma separated; blank disables the untrusted-network rule
SOC_INITIAL_LOOKBACK_HOURS=24
SOC_OVERLAP_MINUTES=30              # re-read window for late-arriving log events (duplicates are skipped)

# --- FinOps ---
FX_USD_INR_RATE=                    # e.g. 84.10 ; blank = INR amounts are left empty rather than guessed
FINOPS_LOOKBACK_DAYS=35             # daily cost history re-read each hour
BILLING_PERIODS_HISTORY=6           # closed Azure billing periods kept per subscription (each read once, then cached)

# --- VM thresholds (defaults shown) ---
# VM_CPU_WARNING=80  VM_CPU_CRITICAL=90  VM_MEMORY_WARNING=85  VM_MEMORY_CRITICAL=95  VM_DISK_WARNING=85  VM_DISK_CRITICAL=95
# VM_THRESHOLD_OVERRIDES={"prod": {"cpu": [70, 85]}}

# --- Google Sheets register ---
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=              # create "Multi-Cloud-Operations-Control-Register", share it with the identity, paste its ID

# Service-account key for Google Sheets (and the gmail_api transport). Keep it OUTSIDE the project folder, never commit it.
GOOGLE_APPLICATION_CREDENTIALS=     # e.g. C:\cloudnexus-secrets\sheets-sa.json

# --- Notifications: Daily Governance Dashboard (08:30 IST), alerts and reports ---
CHAT_WEBHOOK_URL=                   # Google Chat space webhook (treat as a secret)
NOTIFY_EMAIL_ENABLED=false
AUDIT_REPORT_PREPARED_BY=Cloud Team         # monthly audit report cover: Prepared By
AUDIT_REPORT_REVIEWED_BY=                   # monthly audit report cover: Reviewed By (empty = filled in by hand)
AUDIT_REPORT_VERSION=v3.0
GMAIL_SENDER=                       # From address, e.g. cloudnexus-alerts@latentview.com (EMAIL_SENDER also accepted)
NOTIFY_EMAIL_TO=                    # comma separated, e.g. ciso@latentview.com,cto@latentview.com
EMAIL_TRANSPORT=smtp                # smtp | gmail_api (service account with domain-wide delegation)
SMTP_HOST=                          # smtp.gmail.com (Google Workspace) | smtp.office365.com (Microsoft 365)
SMTP_PORT=587                       # 587 = STARTTLS, 465 = SSL
SMTP_USERNAME=                      # usually the sender mailbox
SMTP_PASSWORD=                      # app password of that mailbox (Key Vault in production); never your normal password
NOTIFY_QUEUE_MAX_AGE_HOURS=24       # older queued messages are expired, never sent late

# ---- Compliance policy library (Compliance page; job compliance_evaluation at 07:50 and 19:50 IST)
# Audit log retention you actually keep, in days. CERT-In requires 180 days (in India);
# DPDP Rule 8(3) requires one year from 13 May 2027. Policy LOG-04 checks this value.
AUDIT_RETENTION_DAYS=365

# --- AI (optional, advisory only) ---
AI_PROVIDER=none                    # none | gemini | openai
GEMINI_API_KEY=
GEMINI_MODEL=                       # the Gemini model name your key has access to
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- SOC detection and incident e-mail (Cloud audit > Rules; job audit_rule_evaluation)
SOC_ALERT_RECIPIENTS=                # SOC / security distribution list (comma-separated); empty = NOTIFY_EMAIL_TO
SOC_ALERT_SUBJECT_PREFIX=LV NEXUS SOC ALERT
SOC_NOTIFY_AFFECTED_USER=false       # also e-mail the affected user (corporate domain only; never for identity-compromise rules)
SOC_AFFECTED_USER_DOMAINS=           # empty = GOOGLE_ALLOWED_DOMAIN
SOC_AWS_INCLUDE_READ_EVENTS=false    # true = also collect CloudTrail read events (needed by reconnaissance rules AUD-043/049/050/069/070; more volume)
SOC_GCP_INCLUDE_DATA_ACCESS=false    # true = also read GCP Data Access logs where enabled (needed by AUD-049/067/068)

# ---- Native security findings (AWS Security Hub, Azure Advisor, Google SCC) and vulnerability management ----
SECURITY_SYNC_ENABLED=true
# Security Hub cross-region aggregation region of the administrator account (empty = read every enabled region of every account)
AWS_SECURITYHUB_AGGREGATION_REGION=
# Security Hub delegated administrator account ID (empty = the AWS Organizations management account)
AWS_SECURITYHUB_ADMIN_ACCOUNT_ID=
SECURITY_SYNC_FULL_EVERY_DAYS=7
SECURITY_SYNC_OVERLAP_MINUTES=60
SECURITY_SYNC_LOCK_TTL_SECONDS=21600
SECURITY_REOPEN_ON_REAPPEAR=true
EXCEPTION_DEFAULT_DAYS=90
EXCEPTION_MAX_DAYS=365
EXCEPTION_EXPIRY_NOTICE_DAYS=14
# Evidence files are stored here, named by SHA-256, outside the web root. Back it up with the database.
EVIDENCE_DIR=../evidence-store
EVIDENCE_MAX_BYTES=10485760
AUDIT_CASE_GROUP_HOURS=24
INVESTIGATION_SLA_HOURS=72
CRITICAL_UNASSIGNED_HOURS=4

# ---- API hardening ----
RATE_LIMIT_PER_MINUTE=1200          # API requests per client IP per minute (0 = off)
AUTH_RATE_LIMIT_PER_MINUTE=30       # sign-in endpoints per client IP per minute

# ---- Cost detail (cost_detail_refresh) ----
COST_DETAIL_DAYS=35
COST_TAG_KEYS=environment,cost-center,business-entity   # tag / label keys for allocation views
COST_INCLUDE_AMORTIZED=true
AWS_RESOURCE_COST_ENABLED=false     # true only after enabling resource-level data in AWS Cost Explorer (last 14 days)
GCP_BILLING_DETAILED_EXPORT_TABLE=  # project.dataset.gcp_billing_export_resource_v1_XXXX (resource-level cost)
FINANCIAL_YEAR_START_MONTH=4        # April

# --- v3: secrets, access view, anomaly detection ---
# Azure Key Vault holding the secrets (required in production; .env is only for APP_ENV=local)
AZURE_KEY_VAULT_URL=
# Legacy access request / approval / review API (UI removed). Keep false.
ACCESS_WORKFLOWS_ENABLED=false
ANOMALY_BASELINE_DAYS=30
ANOMALY_MIN_BASELINE_EVENTS=20
ANOMALY_FAILURE_THRESHOLD=10
ANOMALY_FAILURE_WINDOW_MINUTES=15
ANOMALY_MASS_DELETE_THRESHOLD=20
ANOMALY_MASS_DELETE_WINDOW_MINUTES=10
ANOMALY_TIMEZONE=Asia/Kolkata
