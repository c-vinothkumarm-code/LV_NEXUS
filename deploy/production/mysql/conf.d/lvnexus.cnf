[mysqld]
# character set used by the application
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# hardening
local_infile             = 0          # no LOAD DATA LOCAL
skip_name_resolve        = ON
secure_file_priv         = /var/lib/mysql-files
max_connections          = 200
max_allowed_packet       = 64M

# the append-only audit tables are protected by triggers (needs this with binary logging on)
log_bin_trust_function_creators = 1

# durability and point-in-time recovery (binary logs kept 7 days; nightly dumps by scripts/backup.sh)
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1
binlog_expire_logs_seconds     = 604800

# memory: tune to the server (about 50-60 % of the RAM given to the db container)
innodb_buffer_pool_size = 2G
innodb_redo_log_capacity = 1G

# slow query visibility
slow_query_log      = ON
long_query_time     = 2
