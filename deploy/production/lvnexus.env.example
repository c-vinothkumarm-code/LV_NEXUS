# LV NEXUS production settings. scripts/install.sh copies this to secrets/lvnexus.env (chmod 600) and fills the generated
# values. Placeholders only: NEVER commit the real file. Values in <angle brackets> must be replaced.

# ---- application
APP_ENV=production
APP_NAME=LV NEXUS
FRONTEND_URL=https://<lvnexus.your-domain>
CORS_ORIGINS=https://<lvnexus.your-domain>
SESSION_SECRET=<generated by install.sh>
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
RATE_LIMIT_PER_MINUTE=1200
AUTH_RATE_LIMIT_PER_MINUTE=30
AUDIT_RETENTION_DAYS=365

# ---- database (bundled db: install.sh writes the generated password into this URL; external db: your managed MySQL, with TLS)
DATABASE_URL=mysql+pymysql://lvnexus:<generated>@db:3306/lvnexus?charset=utf8mb4

# ---- secrets from Azure Key Vault (recommended: then leave the secret values below empty)
AZURE_KEY_VAULT_URL=

# ---- sign-in (Google Workspace)
AUTH_MODE=google
GOOGLE_OAUTH_CLIENT_ID=<client id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<lvnexus.your-domain>/api/v1/auth/callback
GOOGLE_ALLOWED_DOMAIN=latentview.com
ALLOWED_EMAIL_DOMAINS=latentview.com
BOOTSTRAP_ADMIN_EMAILS=<admin1>@latentview.com,<admin2>@latentview.com

# ---- Azure (certificate preferred over a client secret; file mounted read-only at /run/secrets/cloud)
AZURE_ENABLED=true
AZURE_TENANT_ID=<tenant id>
AZURE_CLIENT_ID=<application (client) id>
AZURE_CLIENT_CERTIFICATE_PATH=/run/secrets/cloud/azure-lvnexus.pem
AZURE_CLIENT_SECRET=
AZURE_PRINCIPAL_OBJECT_ID=<service principal object id>

# ---- AWS (IAM Roles Anywhere on the server: profile defined in /run/secrets/cloud/aws/config, no access keys)
AWS_ENABLED=true
AWS_CONFIG_FILE=/run/secrets/cloud/aws/config
AWS_PROFILE=cloudnexus-prod
AWS_DEFAULT_REGION=ap-south-1
AWS_REGIONS=ap-south-1,us-east-1
AWS_MEMBER_ROLE_NAME=CloudNexusReadOnly
AWS_EXTERNAL_ID=
AWS_MANAGEMENT_ROLE_ARN=
AWS_WEB_IDENTITY_AUDIENCE=

# ---- Google Cloud (Workload Identity Federation config, or a key file as a fallback)
GCP_ENABLED=false
GCP_ORGANIZATION_ID=
GCP_CREDENTIALS_FILE=/run/secrets/cloud/gcp-lvnexus.json
GCP_BILLING_EXPORT_TABLE=
GCP_BILLING_QUERY_PROJECT=

# ---- e-mail, Google Chat, Sheets
NOTIFY_EMAIL_ENABLED=true
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=<sender>@latentview.com
SMTP_PASSWORD=
GMAIL_SENDER=<sender>@latentview.com
NOTIFY_EMAIL_TO=<cloud-governance-list>@latentview.com
SOC_ALERT_RECIPIENTS=<soc-list>@latentview.com
SOC_NOTIFY_AFFECTED_USER=false
CHAT_WEBHOOK_URL=
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- AI assistant: keep "none" unless a model vendor is approved (risk R8)
AI_PROVIDER=none
