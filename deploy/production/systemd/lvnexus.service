[Unit]
Description=LV NEXUS multi-cloud control plane (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@LVNEXUS_DIR@
EnvironmentFile=-@LVNEXUS_DIR@/.stack.env
ExecStart=/bin/sh -c 'LVNEXUS_IMAGE="$(cat .last-good-image)" exec docker compose --profile bundled-db up -d db api scheduler proxy'
ExecStop=/usr/bin/docker compose --profile bundled-db stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
